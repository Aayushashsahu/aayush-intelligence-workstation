# ============================================================================
# AAYUSH // INTELLIGENCE WORKSTATION
# All of these are SERVER-SIDE ONLY.
# Never prefix any of them with NEXT_PUBLIC_, and never commit real values.
# ============================================================================

# --- LIVE DATA: GitHub ------------------------------------------------------
GITHUB_USERNAME=Aayushashsahu

# Optional but recommended: enables the exact contribution calendar via GraphQL.
# Read server-side in lib/github.ts and never sent to the browser.
GITHUB_TOKEN=

# --- CORTEX reasoning -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- CURATED CONTENT STORE (MongoDB Atlas) ----------------------------------
# If unset, the site serves the committed seed content and the control room
# reports "SEED FALLBACK" instead of breaking.
MONGODB_URI=
# Optional: defaults to the database named in the URI, else "workstation".
MONGODB_DB=workstation

# --- OWNER-ONLY CONTROL ROOM ------------------------------------------------
# The only GitHub login allowed into /control. Case-insensitive.
OWNER_GITHUB_LOGIN=Aayushashsahu

# GitHub OAuth App credentials (Settings > Developer settings > OAuth Apps).
# Authorization callback URL must be: https://YOUR_DOMAIN/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Signs the session cookie. If unset, GITHUB_OAUTH_CLIENT_SECRET is used as the
# signing key. Set this in production so rotating the OAuth secret does not
# invalidate sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=
